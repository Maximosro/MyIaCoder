{
  "name": "ai-code-manager",
  "version": "2.0.1",
  "description": "Desktop app to manage multiple projects with integrated Claude Code terminal",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "npm run build:python && npm run rebuild:sqlite && npm run build && electron-builder --win",
    "build:python": "powershell -ExecutionPolicy Bypass -File scripts/build-embedded-python.ps1",
    "build:model": "py scripts/prepare_model.py small sidecar-dist/model",
    "build:tts": "py scripts/prepare_tts_voice.py es_ES-davefx-medium sidecar-dist/tts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "rebuild:sqlite": "cd node_modules/better-sqlite3 && node ../prebuild-install/bin.js -r electron -t 35.7.5 --arch x64"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^0.460.0",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.52.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.2.0-beta.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/marked": "^5.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.28.0",
    "vitest": "^3.0.0"
  }
}
